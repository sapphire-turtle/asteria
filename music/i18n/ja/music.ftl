# asteria-music の文字列。キーは `asteria-music-<area>-<what>`。

# レール。
asteria-music-screen-albums = アルバム
asteria-music-screen-artists = アーティスト
asteria-music-screen-playlists = プレイリスト
asteria-music-screen-queue = キュー
asteria-music-screen-settings = 設定

# 接続。
asteria-music-library-connecting = { $name } に接続しています...
asteria-music-library-connect-failed = { $name } に接続できませんでした: { $reason }
asteria-music-library-no-servers = サーバーを追加すると、音楽が表示されます。
asteria-music-library-no-active = サーバーを選ぶと、そのサーバーの音楽が表示されます。
asteria-music-library-open-servers = サーバーの設定
asteria-music-library-retry = もう一度試す
asteria-music-library-loading = 読み込んでいます...
asteria-music-library-failed = 読み込めませんでした: { $reason }

# サーバー一覧の保存。
asteria-music-save-failed = サーバー一覧を保存できませんでした: { $reason }
asteria-music-load-failed = サーバー一覧を読めなかったため、変更は保存されません: { $reason }

# 一覧。
asteria-music-albums-empty = アルバムはまだありません。
asteria-music-artists-empty = アーティストはまだいません。
asteria-music-playlists-empty = プレイリストはまだありません。
asteria-music-artists-albums = { $count }枚のアルバム

# 開いたアルバム、アーティスト、プレイリスト。
asteria-music-detail-back = 戻る
asteria-music-detail-album-tracks = { $count }曲
asteria-music-detail-own-albums = アルバム
asteria-music-detail-appears-on = 参加しているアルバム
asteria-music-detail-truncated = このプレイリストは長いため、先頭の曲だけを表示しています。

# 曲の表。
asteria-music-tracks-disc = ディスク
asteria-music-tracks-number = #
asteria-music-tracks-title = 曲名
asteria-music-tracks-artist = アーティスト
asteria-music-tracks-length = 長さ
asteria-music-tracks-moved = 移動済み
asteria-music-tracks-moved-hover = このファイルは移動されていましたが、新しい場所で見つかりました。
asteria-music-tracks-missing-hover = { $path } のファイルが見つかりません。
asteria-music-tracks-play-next = 次に再生
asteria-music-tracks-append = キューに追加
