# The external tools the desktop packages carry (spec §5.9), pinned by a versioned URL and
# its SHA-256 so that a release always bundles the same bytes. packaging/fetch-tools.sh
# sources this file. To move to newer builds, replace a URL, download it once and put
# `curl -fsSL <url> | sha256sum` beside it; then update packaging/LICENSES-tools.md.

# FFmpeg 9.0.2 for Windows x64, GPL (libopus, libwebp), static: BtbN/FFmpeg-Builds, from a
# dated autobuild release (the `latest` one is replaced every day).
WIN_FFMPEG_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-11-01-12-49/ffmpeg-n9.0.2-42-gd7643a0fe3-win64-gpl-9.0.zip
WIN_FFMPEG_SHA256=ce92c2ee8a90fbe3da3e8a2bd510f4ebc0e838d4cf433371095ac2179f95e834

# libvips 8.18.7 for Windows x64 with its DLLs ("all" variant): libvips/build-win64-mxe.
WIN_VIPS_URL=https://github.com/libvips/build-win64-mxe/releases/download/v8.18.7/vips-dev-x64-all-8.18.7.zip
WIN_VIPS_SHA256=78e56ba30c267ba32ff965200534bd5721364cadbead8c4d595e44b58dfeff15

# FFmpeg 9.0.2 for macOS, GPLv3 (libopus, libwebp), static apart from the system frameworks:
# ffmpeg.martin-riedl.de, the versioned URLs that redirect/latest/macos/<arch>/release/ffmpeg.zip
# pointed to. Never the osxexperts builds: they are configured with --enable-nonfree.
MAC_FFMPEG_ARM64_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2/ffmpeg.zip
MAC_FFMPEG_ARM64_SHA256=c8ed4c4e6978a03c485edbfe4e0a5dc2380f8a30bba5150531b31b094492d924
MAC_FFMPEG_X86_64_URL=https://ffmpeg.martin-riedl.de/download/macos/amd64/1789931006_9.0.2/ffmpeg.zip
MAC_FFMPEG_X86_64_SHA256=7c6b4125b191cbf773832dc51f424cf2b6bb7da43007d1e066f95909e47cacd4
